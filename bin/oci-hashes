#!/usr/bin/env bash
set -euo pipefail

filter="${1:-}"

entries=$(yq -o=json data/oci-repos.yaml | jq -r '
  to_entries[] |
  .key as $name |
  .value.registry as $registry |
  .value.charts | to_entries[] |
  "\($name)\t\(.key)\t\($registry)"
')

if [[ -n "$filter" ]]; then
  entries=$(echo "$entries" | grep "^${filter}	" || true)
fi

total=$(echo "$entries" | grep -c . || true)
[[ "$total" -eq 0 ]] && exit 0

echo "$entries" |
while IFS=$'\t' read -r name chart registry; do
  category=$(bin/chart-category "$name")
  nix eval --json --file "charts/${category}/${name}/${chart}.nix" versions |
    jq -r --arg name "$name" --arg chart "$chart" --arg registry "oci://$registry" \
      'to_entries[] | "\($name) \($chart) \(.key) \($registry) \(.value)"'
done
