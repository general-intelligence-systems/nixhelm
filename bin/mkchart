#!/usr/bin/env bash
set -euo pipefail

versions=""
latest=""
repo=""
chart=""
declare -A seen

while read -r name ch version url hash; do
  [[ -z "$latest" ]] && latest="$version"
  [[ -z "$repo" ]] && repo="$url"
  [[ -z "$chart" ]] && chart="$ch"
  [[ -n "${seen[$version]:-}" ]] && continue
  seen[$version]=1
  versions+="    \"$version\" = \"$hash\";"$'\n'
done

cat <<EOF
{
  repo = "$repo";
  chart = "$chart";
  latest = "$latest";
  versions = {
$versions  };
}
EOF
