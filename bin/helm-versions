#!/usr/bin/env bash
set -euo pipefail

filter="${1:-}"

entries=$(yq -o=json data/http-repos.yaml | jq -r '
  to_entries[] |
  .key as $name |
  .value[] |
  "\($name)\t\(.)"
')

if [[ -n "$filter" ]]; then
  entries=$(echo "$entries" | grep "^${filter}	" || true)
fi

total=$(echo "$entries" | grep -c . || true)
[[ "$total" -eq 0 ]] && exit 0
echo "$entries" |
while IFS=$'\t' read -r name url; do
  curl -sL "$url/index.yaml" | yq -o=json '.entries' |
  jq -r 'to_entries[] | .key as $chart | .value[] | "\($chart)\t\(.version)\t\(.digest)"' |
  while IFS=$'\t' read -r chart version hex; do
    hash=$(echo "$hex" | xxd -r -p | base64 | tr -d '\n')
    echo "$name $chart $version $url sha256-$hash"
  done | sort -t' ' -k2,2 -k3,3rV
done
