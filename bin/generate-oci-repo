#!/usr/bin/env bash
set -euo pipefail

repo="$1"
category=$(bin/chart-category "$repo")

# Get only new versions that don't already have hashes
new_lines=$(bin/oci-new-versions "$repo")
new_count=$(echo "$new_lines" | grep -c . || true)

[[ "$new_count" -eq 0 ]] && exit 0

# Hash only the new versions
new_hashed=$(echo "$new_lines" | while read -r line; do
  echo "$line" | bin/hash-oci-version
done)

# Combine with existing hashes and sort newest first
existing=$(bin/oci-hashes "$repo")
all_versions=$(printf '%s\n%s\n' "$existing" "$new_hashed" | grep . | sort -k3 -rV)

# Write chart files
echo "$all_versions" | awk '{print $2}' | sort -u | while read -r chart; do
  mkdir -p "charts/${category}/${repo}"
  echo "$all_versions" | grep "^$repo $chart " | bin/mkchart > "charts/${category}/${repo}/${chart}.nix"
done
