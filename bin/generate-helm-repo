#!/usr/bin/env bash
set -euo pipefail

repo="$1"
category=$(bin/chart-category "$repo")

versions=$(bin/helm-versions "$repo")

mkdir -p "charts/$category/$repo"

echo "$versions" | awk '{print $2}' | sort -u | while read -r chart; do
  echo "$versions" | grep "^$repo $chart " | bin/mkchart > "charts/$category/$repo/$chart.nix"
done
