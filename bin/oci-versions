#!/usr/bin/env bash
set -euo pipefail

yq -o=json data/oci-repos.yaml | jq -r '
  to_entries[] |
  .key as $name |
  .value.registry as $registry |
  .value.charts | to_entries[] |
  "\($name)\t\(.key)\t\($registry)\t\(.value.regex)"
' |
while IFS=$'\t' read -r name chart registry regex; do
  crane ls "$registry/$chart" 2>/dev/null | grep -E "$regex" | sort -rV |
  while read -r version; do
    echo "$name $chart $version $registry"
  done
done
